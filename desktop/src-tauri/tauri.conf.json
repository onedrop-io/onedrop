{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "OneDrop",
    "version": "0.1.0",
    "identifier": "io.onedrop.desktop",
    "build": {
        "devUrl": "http://localhost:1420",
        "frontendDist": "../dist",
        "beforeDevCommand": "npm run desktop:vite",
        "beforeBuildCommand": "npm run desktop:vite:build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "create": false,
                "title": "OneDrop",
                "width": 1360,
                "height": 860,
                "minWidth": 820,
                "minHeight": 560
            }
        ],
        "security": {
            "csp": {
                "default-src": "'self'",
                "script-src": "'self'",
                "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
                "img-src": "'self' data: blob: http: https:",
                "frame-src": "http: https:",
                "media-src": "'self' blob: http: https:",
                "worker-src": "'self' blob:",
                "style-src": "'self' 'unsafe-inline' https://fonts.bunny.net",
                "font-src": "'self' data: https://fonts.bunny.net"
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "DeveloperTool",
        "shortDescription": "Vibe-code apps for production",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "createUpdaterArtifacts": true
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFRUVGRkU5MkY2QTQxNUEKUldSYVFXb3Y2Zi91SHZUSHRIaHZmWkx3TkdIZzdoc1BXZ2UyNDh4dHdTOU9FeGtnMksya2FVczMK",
            "endpoints": [
                "https://github.com/onedrop-io/onedrop/releases/download/desktop-latest/latest.json"
            ]
        },
        "deep-link": {
            "desktop": {
                "schemes": ["onedrop"]
            }
        }
    }
}
