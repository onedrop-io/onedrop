{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "OneDrop",
    "colors": {
        "primary": "#FF4D1C",
        "light": "#FF9A5C",
        "dark": "#E8341C"
    },
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg",
        "href": "https://onedrop.io"
    },
    "favicon": "/favicon.svg",
    "appearance": {
        "default": "dark"
    },
    "background": {
        "color": {
            "light": "#FFFCFA",
            "dark": "#0A0807"
        }
    },
    "fonts": {
        "heading": {
            "family": "Schibsted Grotesk",
            "weight": 700
        },
        "body": {
            "family": "Instrument Sans"
        }
    },
    "icons": {
        "library": "lucide"
    },
    "navigation": {
        "tabs": [
            {
                "tab": "Guides",
                "icon": "book-open",
                "groups": [
                    {
                        "group": "Get started",
                        "icon": "rocket",
                        "pages": [
                            "introduction",
                            "install",
                            "quickstart",
                            "pricing"
                        ]
                    },
                    {
                        "group": "Build apps",
                        "icon": "hammer",
                        "pages": [
                            "guides/set-up-ai",
                            "guides/build-a-project",
                            "guides/tasks",
                            "guides/requirements",
                            "guides/tests",
                            "guides/workspace",
                            "guides/tables",
                            "guides/users-and-auth",
                            "guides/secrets",
                            "guides/feature-flags",
                            "guides/app-storage",
                            "guides/app-icon",
                            "guides/developer-tools",
                            "guides/docker-compose",
                            "guides/git",
                            "guides/agent-skills",
                            "guides/publish",
                            "guides/hosting",
                            "guides/share"
                        ]
                    },
                    {
                        "group": "Your team",
                        "icon": "users",
                        "pages": [
                            "guides/organizations",
                            "guides/settings",
                            "guides/usage",
                            "guides/invite-people",
                            "guides/groups-and-users",
                            "guides/remote-access"
                        ]
                    }
                ]
            },
            {
                "tab": "Self-hosting & development",
                "icon": "server",
                "groups": [
                    {
                        "group": "Self-hosting",
                        "icon": "cloud",
                        "pages": [
                            "self-hosting/deploy-aws",
                            "self-hosting/install-anywhere",
                            "self-hosting/server-mode",
                            "self-hosting/cloudflare-preview-gateway",
                            "self-hosting/administration",
                            "self-hosting/configuration",
                            "self-hosting/live-updates",
                            "self-hosting/social-login",
                            "self-hosting/github-app",
                            "self-hosting/sandboxes",
                            "self-hosting/hosting",
                            "self-hosting/tailscale"
                        ]
                    },
                    {
                        "group": "Development",
                        "icon": "code",
                        "pages": [
                            "development/architecture",
                            "development/contributing",
                            "development/troubleshooting"
                        ]
                    }
                ]
            },
            {
                "tab": "Manual testing",
                "icon": "clipboard-check",
                "hidden": true,
                "groups": [
                    {
                        "group": "Manual testing",
                        "icon": "clipboard-check",
                        "public": false,
                        "pages": [
                            "testing/overview",
                            "testing/agents",
                            "testing/shell",
                            "testing/tools",
                            "testing/sandboxes",
                            "testing/publishing"
                        ]
                    }
                ]
            }
        ]
    },
    "footer": {
        "socials": {
            "github": "https://github.com/onedrop-io/onedrop"
        }
    }
}
