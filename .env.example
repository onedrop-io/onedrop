APP_NAME=OneDrop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Log in with... (buttons show once a provider's ID and secret are set).
# Callback URL for each: ${APP_URL}/login/{google,microsoft,github,gitlab,oidc}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App for Tools → Git (connect repositories without tokens). See config/services.php for how to create it.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_HOST=https://gitlab.com
OIDC_LABEL="Single sign-on"
OIDC_BASE_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional: connects this Claude key/token to the seeded dev user
DEV_CLAUDE_CREDENTIAL=

# Sandboxes: docker locally; e2b/daytona in production (not built yet)
SANDBOX_PROVIDER=docker
# Production: SANDBOX_PROVIDER=blaxel with a Blaxel key and workspace (Blaxel console → API keys),
# or SANDBOX_PROVIDER=runtime with a Runtime Cloud key (https://withruntime.com/account/keys).
BL_API_KEY=
BL_WORKSPACE=
RUNTIME_API_KEY=
RUNTIME_FUNDING=trial
# OpenCode models per connected AI (provider/model)
SANDBOX_MODEL_CLAUDE=anthropic/claude-sonnet-5
SANDBOX_MODEL_CODEX=openai/gpt-5.6
SANDBOX_MODEL_OPENROUTER=openrouter/anthropic/claude-sonnet-5
SANDBOX_MODEL_GEMINI=google/gemini-3.8-flash
SANDBOX_CALLBACK_URL=http://host.docker.internal:8000
# Where each project's code is backed up after every agent turn (a filesystem disk, e.g. s3).
SANDBOX_BACKUP_DISK=local
# Let Tools → Git push to remotes on private networks (e.g. a self-hosted Forgejo on your LAN).
SANDBOX_GIT_ALLOW_PRIVATE_REMOTES=false

# Publishing: reusable + ephemeral auth key tagged e.g. tag:zap-preview (Funnel allowed for the tag)
SANDBOX_PUBLISHER=tailscale
TAILSCALE_AUTHKEY=
