# Zap on a server. APP_DOMAIN is set by bootstrap.sh (systemd drop-in).
{
	# Only issue certificates for preview-<id>/shell-<id> hosts of sandboxes that exist.
	on_demand_tls {
		ask http://127.0.0.1:8080/sandbox-gateway/certificate
	}
}

(laravel) {
	root * /opt/zap/current/public
	encode zstd gzip
	php_fastcgi unix//run/php/php8.4-fpm-zap.sock
	file_server
}

# Internal listener for Caddy's own checks (certificate "ask" and forward_auth). Loopback only.
# No hostname: forward_auth keeps the original Host header, so this must answer for any host.
http://:8080 {
	bind 127.0.0.1
	import laravel
}

# The app builder.
{$APP_DOMAIN} {
	# Gateway endpoints are for Caddy only.
	handle /sandbox-gateway/* {
		respond 404
	}

	# Older releases scoped these cookies to every subdomain; delete those copies (the app's own are host-only).
	header +Set-Cookie "XSRF-TOKEN=; Domain={$APP_DOMAIN}; Path=/; Max-Age=0; Secure"
	header +Set-Cookie "laravel-session=; Domain={$APP_DOMAIN}; Path=/; Max-Age=0; Secure; HttpOnly"

	handle {
		import laravel
	}
}

# Sandbox previews and shells: preview-<id>.<domain>, shell-<id>.<domain>.
*.{$APP_DOMAIN} {
	tls {
		on_demand
	}

	# route keeps these in the written order (Caddy would otherwise reorder them).
	route {
		# Never trust a client-supplied upstream.
		request_header -X-Zap-Upstream

		# The app's hand-off lands here; Laravel sets this address's own zap_gateway cookie.
		@enter path /__zap/enter
		reverse_proxy @enter 127.0.0.1:8080

		# Laravel checks the zap_gateway cookie and answers with the sandbox's local address.
		forward_auth 127.0.0.1:8080 {
			uri /sandbox-gateway/authorize
			copy_headers X-Zap-Upstream
		}

		# Code in the sandbox never sees the gateway cookie.
		reverse_proxy {http.request.header.X-Zap-Upstream} {
			header_up Cookie "(^|;\s*)zap_gateway=[^;]*(;\s*)?" "$1"
		}
	}
}
