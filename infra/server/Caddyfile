# OneDrop on a server. APP_DOMAIN is set by bootstrap.sh (systemd drop-in).
{
	# Only issue certificates for preview-<id>/shell-<id> hosts of sandboxes that exist, published apps, and custom domains.
	on_demand_tls {
		ask http://127.0.0.1:8080/sandbox-gateway/certificate
	}
	# Settings → Server (ADMIN-004): the Let's Encrypt email and "local_certs", written by apply-server-settings.
	import /etc/caddy/onedrop-options.caddy
}

(laravel) {
	root * /opt/onedrop/current/public
	encode zstd gzip
	php_fastcgi unix//run/php/php8.4-fpm-onedrop.sock
	file_server
}

# Internal listener for Caddy's own checks (certificate "ask" and forward_auth). Loopback only.
# No hostname: forward_auth keeps the original Host header, so this must answer for any host.
http://:8080 {
	bind 127.0.0.1
	import laravel
}

# The app builder.
{$APP_DOMAIN} {
	# Gateway endpoints are for Caddy only.
	handle /sandbox-gateway/* {
		respond 404
	}

	# Older releases scoped these cookies to every subdomain; delete those copies (the app's own are host-only).
	header +Set-Cookie "XSRF-TOKEN=; Domain={$APP_DOMAIN}; Path=/; Max-Age=0; Secure"
	header +Set-Cookie "laravel-session=; Domain={$APP_DOMAIN}; Path=/; Max-Age=0; Secure; HttpOnly"

	# Live updates (LIVE-001): browsers' WebSockets to Reverb. Only the socket path; Reverb's HTTP API
	# (/apps/...) stays on loopback, where the app sends from.
	handle /app/* {
		reverse_proxy 127.0.0.1:8081
	}

	handle {
		import laravel
	}
}

# Gateway traffic: Laravel authorizes each request and names the sandbox's local address.
(gateway) {
	# route keeps these in the written order (Caddy would otherwise reorder them).
	route {
		# Never trust a client-supplied upstream.
		request_header -X-OneDrop-Upstream
		request_header -X-OneDrop-Host

		# Only OneDrop's Cloudflare Worker says where a visitor is (Growth); a browser can't place itself.
		request_header -X-OneDrop-Geo-Country
		request_header -X-OneDrop-Geo-Region
		request_header -X-OneDrop-Geo-City
		request_header -X-OneDrop-Geo-Latitude
		request_header -X-OneDrop-Geo-Longitude

		# The app's hand-off lands here; Laravel sets this address's own onedrop_gateway cookie.
		@enter path /__onedrop/enter
		reverse_proxy @enter 127.0.0.1:8080

		# Laravel checks the onedrop_gateway cookie and answers with the sandbox's local address.
		forward_auth 127.0.0.1:8080 {
			uri /sandbox-gateway/authorize
			copy_headers X-OneDrop-Upstream
		}

		# Code in the sandbox never sees the gateway cookie.
		reverse_proxy {http.request.header.X-OneDrop-Upstream} {
			header_up Cookie "(^|;\s*)onedrop_gateway=[^;]*(;\s*)?" "$1"
		}
	}
}

# Sandbox previews and shells: preview-<id>.<domain>, shell-<id>.<domain>, and projects published to the domain.
*.{$APP_DOMAIN} {
	tls {
		on_demand
	}

	import gateway
}

# Custom domains of projects published to the domain (DOM-001). The certificate "ask" only approves names a project
# added, so nobody else's names pointed here get certificates.
https:// {
	tls {
		on_demand
	}

	import gateway
}
