#!/usr/bin/env bash
# Gives a task its own copy of the app (TASK-003), whatever it's built with, and brings its work back.
#
#   fork snapshot DIR PATH...   Copy each PATH into DIR/<index> as it was at one instant, so databases' files are
#                               consistent (as after a power cut, which they recover from): a live copy first, then a
#                               second pass with the app's processes and its Docker containers frozen, usually for about
#                               a second. Run as root, so files the containers own come along (a database's own user).
#                               Writes DIR/.done, or DIR/.failed with the reason. Takes a while: run it detached.
#   fork branch NAME            In a task's copy: start branch NAME at the current commit. Prints the commit.
#   fork bundle OUT MESSAGE     Commit everything (as MESSAGE), then write the current branch's history to the git bundle OUT.
#   fork merge BUNDLE MESSAGE   Commit everything, then merge the bundle's branch into the current one.
#                               Exits 0 when merged (or nothing to merge), 3 on conflicts (left for the agent to resolve).
#   fork images                 List the images the app's Docker built itself, which no registry has: "ID TAG..." per line.
#   fork save-image DIR FILE TAG...
#                               Save the image with those tags, compressed, to FILE, then upload it to $ONEDROP_IMAGE_URL
#                               (headers in $ONEDROP_IMAGE_HEADERS) when set. Writes DIR/.done or DIR/.failed. Run detached.
#   fork load-image DIR SOURCE  Load an image saved that way from SOURCE: a file, or "url" ($ONEDROP_IMAGE_URL), once the
#                               sandbox's Docker is up. Writes DIR/.done or DIR/.failed. Run detached.
#   fork services               List data services the app's settings point at outside the sandbox (host per line):
#                               a forked copy still shares those.
set -uo pipefail

export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="*"
WORKSPACE="${ONEDROP_WORKSPACE:-/workspace}"
AUTHOR=(-c user.name="${ONEDROP_GIT_AUTHOR_NAME:-OneDrop}" -c user.email="${ONEDROP_GIT_AUTHOR_EMAIL:-agent@onedrop.io}" -c commit.gpgsign=false)

# Everything under DIR goes, including dependencies (node_modules, vendor, .venv): the copy should run as it is.
# A file that vanished mid-copy (rsync's 24, e.g. a database's journal) is fine: it's gone from the source too.
copy() {
    if command -v rsync >/dev/null 2>&1; then
        rsync -a --delete "$1/" "$2/" || [ $? -eq 24 ]
    else
        rm -rf "$2" && mkdir -p "$2" && cp -a "$1/." "$2/"
    fi
}

# Whether process $1 is $2 or runs under it.
descends_from() {
    local pid="$1" target="$2"

    while [ -n "$pid" ] && [ "$pid" -gt 1 ]; do
        [ "$pid" = "$target" ] && return 0
        pid="$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null)"
    done

    return 1
}

snapshot() {
    local dir="$1"
    shift
    rm -rf "$dir" && mkdir -p "$dir" || return 1

    local index=0

    for path in "$@"; do
        mkdir -p "$dir/$index"
        [ -d "$path" ] && { copy "$path" "$dir/$index" || return 1; }
        index=$((index + 1))
    done

    # Freeze the app: its Docker containers first (their own users, so only Docker can), then the processes (the dev
    # server, databases, workers, agents, dockerd): everything of the sandbox user and everything start.sh started,
    # except this script, its children, and what started it (the sandbox's own API). A watchdog thaws them if we don't.
    local me=$$ uid frozen="$dir/.frozen" paused="$dir/.paused"
    uid="$(id -u sandbox 2>/dev/null || id -u)"
    : > "$frozen"
    : > "$paused"
    ( sleep 60; xargs -r kill -CONT < "$frozen"; xargs -r timeout 20 docker unpause < "$paused" ) >/dev/null 2>&1 &
    local watchdog=$!

    if command -v docker >/dev/null 2>&1; then
        timeout 20 docker ps -q 2>/dev/null | while read -r container; do
            timeout 20 docker pause "$container" >/dev/null 2>&1 && echo "$container" >> "$paused"
        done
    fi

    # start.sh itself, not the init that runs it (pid 1 names it too).
    local app
    app="$(pgrep -o -f '^[^ ]*bash /opt/onedrop/start\.sh')"

    for proc in /proc/[0-9]*; do
        local pid="${proc#/proc/}"
        [ "$pid" = 1 ] && continue
        [ "$(stat -c %u "$proc" 2>/dev/null)" = "$uid" ] || { [ -n "$app" ] && descends_from "$pid" "$app"; } || continue
        # This script and what it runs, what started it (the sandbox's own API), and the watchdog keep running.
        descends_from "$pid" "$me" && continue
        descends_from "$me" "$pid" && continue
        descends_from "$pid" "$watchdog" && continue
        kill -STOP "$pid" 2>/dev/null && echo "$pid" >> "$frozen"
    done

    local status=0
    index=0

    for path in "$@"; do
        [ -d "$path" ] && { copy "$path" "$dir/$index" || status=1; }
        index=$((index + 1))
    done

    # Processes first: dockerd may be one of them, and it unpauses the containers.
    xargs -r kill -CONT < "$frozen" 2>/dev/null
    xargs -r timeout 20 docker unpause < "$paused" >/dev/null 2>&1
    pkill -P "$watchdog" 2>/dev/null
    kill "$watchdog" 2>/dev/null
    rm -f "$frozen" "$paused"

    return $status
}

# Run a command, then mark DIR done, or failed with what it said.
finish() {
    local dir="$1" error
    shift
    mkdir -p "$dir"

    if error="$("$@" 2>&1)"; then
        touch "$dir/.done"
    else
        printf '%s' "${error:-failed}" > "$dir/.failed"
    fi
}

docker_up() {
    command -v docker >/dev/null 2>&1 && timeout 20 docker info >/dev/null 2>&1
}

# Built here, or otherwise not in a registry as it is here: a copy couldn't pull it. Docker's containerd image store
# gives built images a digest too, so ask the registry for it (a pulled image's is there; a failed check just means
# the image is carried when it needn't be).
images() {
    local id digests tags
    docker_up || return 0

    while read -r id; do
        IFS="|" read -r digests tags < <(docker image inspect --format '{{join .RepoDigests ","}}|{{join .RepoTags " "}}' "$id")
        [ -n "$tags" ] || continue
        [ -n "$digests" ] && timeout 20 docker buildx imagetools inspect --raw "${digests%%,*}" >/dev/null 2>&1 && continue
        echo "$id $tags"
    done < <(docker image ls -q --no-trunc | sort -u)
}

save_image() {
    local file="$1" header headers=()
    shift
    mkdir -p "$(dirname "$file")"
    docker save "$@" | zstd -q -T0 -3 > "$file" || return 1
    [ -n "${ONEDROP_IMAGE_URL:-}" ] || return 0

    while IFS= read -r header; do [ -n "$header" ] && headers+=(-H "$header"); done <<<"${ONEDROP_IMAGE_HEADERS:-}"
    curl -fsS --retry 3 -X PUT "${headers[@]}" -T "$file" "$ONEDROP_IMAGE_URL" >/dev/null || return 1
    rm -f "$file"
}

load_image() {
    local source="$1" tries=0
    # A new sandbox's Docker starts with it, a few seconds after.
    until docker_up; do
        tries=$((tries + 1))
        [ "$tries" -lt 60 ] || { echo "Docker isn't running in this sandbox." >&2; return 1; }
        sleep 2
    done

    if [ "$source" = url ]; then curl -fsS --retry 3 "$ONEDROP_IMAGE_URL"; else cat "$source"; fi | zstd -q -d | docker load >/dev/null || return 1
    # Copied in as root: the platform clears it away then.
    [ "$source" = url ] || rm -f "$source" 2>/dev/null || true
}

commit_all() {
    printf '%s' "$1" | "${ONEDROP_CHECKPOINT:-/opt/onedrop/checkpoint}"
}

case "${1:-}" in
    snapshot)
        dir="$2"
        shift 2

        if error="$(snapshot "$dir" "$@" 2>&1)"; then
            touch "$dir/.done"
        else
            mkdir -p "$dir" && printf '%s' "${error:-copy failed}" > "$dir/.failed"
        fi
        ;;
    branch)
        cd "$WORKSPACE" || exit 1
        commit_all "Checkpoint"
        [ -d .git ] || git init -q -b main || exit 1
        git rev-parse -q --verify HEAD >/dev/null || git "${AUTHOR[@]}" commit -q --allow-empty -m "Start" || exit 1
        git switch -q -c "$2" 2>/dev/null || git switch -q "$2" || exit 1
        git rev-parse HEAD
        ;;
    bundle)
        cd "$WORKSPACE" || exit 1
        commit_all "$3"
        git bundle create -q "$2" HEAD || exit 1
        ;;
    merge)
        cd "$WORKSPACE" || exit 1

        if [ -e .git/MERGE_HEAD ]; then
            echo "A merge is already in progress; finish it first." >&2
            exit 1
        fi

        commit_all "Checkpoint before merging"
        git fetch -q "$2" "HEAD:refs/onedrop/incoming" --force || exit 1

        if git "${AUTHOR[@]}" merge -q --no-ff --no-edit -m "$3" refs/onedrop/incoming >/dev/null 2>&1; then
            exit 0
        fi

        if [ -e .git/MERGE_HEAD ]; then
            git diff --name-only --diff-filter=U
            exit 3
        fi

        exit 1
        ;;
    images)
        images
        ;;
    save-image)
        dir="$2"
        shift 2
        finish "$dir" save_image "$@"
        ;;
    load-image)
        finish "$2" load_image "$3"
        ;;
    services)
        cd "$WORKSPACE" 2>/dev/null || exit 0
        # URLs of data services (databases, caches, queues, search) and their *_HOST settings in the app's env files.
        cat .env .env.local .env.development .env.development.local 2>/dev/null \
            | grep -v '^\s*#' \
            | grep -oiE '(postgres(ql)?|mysql|mariadb|mongodb(\+srv)?|redis|rediss|amqps?|nats|kafka|clickhouse)://[^/?#[:space:]"]+|^[A-Z0-9_]*(DB|DATABASE|POSTGRES|PG|MYSQL|MONGO|REDIS|CACHE|QUEUE|BROKER|SEARCH|ELASTIC|MEILI)[A-Z0-9_]*_(HOST|SERVER)=[^[:space:]#]+' \
            | sed -E 's#^[a-z+]+://([^@]*@)?##I; s#^[A-Z0-9_]*_(HOST|SERVER)=##; s#["'"'"']##g; s#:[0-9]+$##; s#^\[##; s#\]$##' \
            | grep -viE '^(localhost|127\.[0-9.]+|0\.0\.0\.0|::1)?$' \
            | sort -u
        exit 0
        ;;
    *)
        echo "usage: fork snapshot|branch|bundle|merge|images|save-image|load-image|services ..." >&2
        exit 2
        ;;
esac
