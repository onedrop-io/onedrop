#!/usr/bin/env bash
# The Shell tab's program (ttyd passes ?arg= from the URL). "claude-login" first runs Claude Code's own
# sign-in (AI-005); anything else is ignored, so the URL can't run arbitrary commands. Then a normal shell.
if [ "${1:-}" = "claude-login" ]; then
    echo "Signing in to Claude with Claude Code's own sign-in. OneDrop never sees your Claude login."
    echo
    claude auth login --claudeai
    echo
    echo "You can close this tab and go back to the chat."
    echo
fi

exec bash
