#!/usr/bin/env bash
# Commits everything in the workspace as one checkpoint after an agent turn (forwarder.mjs), so the platform
# can back the code up (BackupProject). The commit message comes on stdin. Starts a repository if there's none.
# The author is OneDrop unless ZAP_GIT_AUTHOR_NAME/EMAIL say otherwise (commits from Tools → Git; see git.php).
# Never fails the caller: a checkpoint that can't be made is skipped.
set -uo pipefail

# Git may run as another user than the one owning the workspace.
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0="*"

cd "${ZAP_WORKSPACE:-/workspace}" 2>/dev/null || exit 0

if [ ! -d .git ]; then
    git init -q -b main || exit 0
fi

# Dependencies, caches, database files (.zap/data) and secrets stay out, whatever the app's .gitignore says.
mkdir -p .git/info
for pattern in node_modules/ vendor/ .cache/ .zap/data/ .env '.env.*' '!.env.example'; do
    grep -qxF -- "$pattern" .git/info/exclude 2>/dev/null || echo "$pattern" >> .git/info/exclude
done

# Mid-merge or mid-rebase: leave it to whoever started it.
if [ -e .git/MERGE_HEAD ] || [ -d .git/rebase-merge ] || [ -d .git/rebase-apply ]; then
    exit 0
fi

git add -A . 2>/dev/null || exit 0

if git diff --cached --quiet 2>/dev/null; then
    exit 0
fi

message="$(cat)"

git -c user.name="${ZAP_GIT_AUTHOR_NAME:-OneDrop}" -c user.email="${ZAP_GIT_AUTHOR_EMAIL:-agent@onedrop.io}" -c commit.gpgsign=false \
    commit -q --no-verify -m "${message:-Checkpoint}" >/dev/null 2>&1 || exit 0
