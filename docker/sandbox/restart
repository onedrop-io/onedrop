#!/usr/bin/env bash
# Restart the preview server (picks up /workspace/.onedrop/dev if it now exists).
set -euo pipefail

if [ -f /tmp/onedrop-server.pid ]; then
    kill -TERM -- "-$(cat /tmp/onedrop-server.pid)" 2>/dev/null || true
fi

echo "Preview server restarting. Logs: /tmp/onedrop-server.log"
