# Shell tab and SSH sessions, loaded from ~/.bashrc (see home-bashrc).
cd /workspace 2>/dev/null || true

# Settings from sandbox start on providers that can't set env at create (see RuntimeSandboxProvider).
[ -f ~/.onedrop-env ] && set -a && . ~/.onedrop-env && set +a

# Service CLIs that install on first use (onedrop-tool), last on PATH. The image sets this too, but SSH sessions start
# with sshd's own PATH, and sandboxes on an older image get the stand-ins before their next new sandbox.
[[ ":$PATH:" == *:/opt/onedrop/lazy:* ]] || PATH="$PATH:/opt/onedrop/lazy"
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

[[ $- == *i* ]] || return

HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize

[ -f /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

alias grep='grep --color=auto'

# Listings use eza when the image has it: folders first, a git column, relative times, sizes and ages shaded by how big or old.
# `ls` with flags eza reads differently (e.g. -ltr, -S) falls back to GNU ls, so muscle memory keeps working.
if command -v eza >/dev/null 2>&1; then
    ls() {
        local arg
        for arg in "$@"; do
            if [[ $arg == -* && ! $arg =~ ^-[laA1R]+$ ]]; then
                command ls --color=auto --group-directories-first "$@"
                return
            fi
        done
        eza --group-directories-first "$@"
    }
    alias ll='eza -l --git --group-directories-first --header --no-user --time-style=relative --color-scale=all'
    alias la='ll -a'
    alias tree='eza --tree --git-ignore --group-directories-first'
else
    alias ls='ls --color=auto --group-directories-first'
    alias ll='ls -lh'
    alias la='ls -lAh'
fi

# fzf: Ctrl-R history search, Ctrl-T file picker, Alt-C cd. Files come from fd, so .gitignore'd ones stay out.
if command -v fzf >/dev/null 2>&1; then
    export FZF_DEFAULT_OPTS='--height=40% --layout=reverse --border'
    if command -v fd >/dev/null 2>&1; then
        export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
        export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
    fi
    eval "$(fzf --bash)"
fi

# zoxide: `z part-of-a-path` jumps to a directory you've been to; `zi` picks one with fzf.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"

# bat: syntax-highlighted cat, in the Shell tab's dark theme.
export BAT_THEME=OneHalfDark

# micro edits files (git commit messages, lazygit's "edit") like a desktop editor: Ctrl-S saves, Ctrl-Q quits.
command -v micro >/dev/null 2>&1 && export EDITOR=micro VISUAL=micro

# Prompt: starship when the image has it; otherwise path, git branch (* unstaged, + staged changes)
# and the exit code of a failed command, e.g. /workspace main* 1 $
# The prompt config comes from the image unless the user made their own ~/.config/starship.toml.
if command -v starship >/dev/null 2>&1; then
    [ -f ~/.config/starship.toml ] || export STARSHIP_CONFIG=/opt/onedrop/starship.toml
    eval "$(starship init bash)"
else
    [ -f /usr/lib/git-core/git-sh-prompt ] && . /usr/lib/git-core/git-sh-prompt
    GIT_PS1_SHOWDIRTYSTATE=1

    __onedrop_prompt() {
        local exit=$?
        local start='\[\e[1;34m\]\w\[\e[0m\]' end=' \$ '
        (( exit )) && end=" \[\e[31m\]${exit}\[\e[0m\]${end}"
        if declare -F __git_ps1 >/dev/null; then
            __git_ps1 "$start" "$end" ' \[\e[35m\]%s\[\e[0m\]'
        else
            PS1="${start}${end}"
        fi
    }
    PROMPT_COMMAND=__onedrop_prompt
fi

# Welcome banner: once per terminal (not again in nested shells), and only when it fits.
__onedrop_banner() {
    local colors=(51 45 39 33 27 21) i=0 line
    while IFS= read -r line; do
        printf '\e[1;38;5;%sm%s\e[0m\n' "${colors[i++]}" "$line"
    done <<'EOF'
                        __
  ____  ____  ___  ____/ /________  ____
 / __ \/ __ \/ _ \/ __  / ___/ __ \/ __ \
/ /_/ / / / /  __/ /_/ / /  / /_/ / /_/ /
\____/_/ /_/\___/\__,_/_/   \____/ .___/
                                /_/
EOF
    printf '\n  \e[1m%s\e[0m \e[2m· /workspace\e[0m\n' "${APP_PROJECT_NAME:-Your sandbox}"
    printf '  \e[2mll · tree · bat · rg · fd · z <dir> · Ctrl-R history\e[0m\n'
    printf '  \e[2mlazygit · btop · micro <file> · /opt/onedrop/restart restarts the preview\e[0m\n'
    printf '  \e[2maws · gcloud · gh · wrangler · …: onedrop-tool list\e[0m\n\n'
}
if [ -z "${ONEDROP_BANNER_SHOWN:-}" ] && (( $(tput cols 2>/dev/null || echo 80) >= 44 )); then
    export ONEDROP_BANNER_SHOWN=1
    __onedrop_banner
fi
unset -f __onedrop_banner
