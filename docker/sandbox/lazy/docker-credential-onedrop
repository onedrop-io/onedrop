#!/usr/bin/env bash
# Docker's credential helper for ghcr.io (GIT-016): signs in with GITHUB_TOKEN, the project owner's GitHub token (or
# a secret of that name), read when Docker asks so the token is never written into Docker's config. The platform names
# it for ghcr.io in ~/.docker/config.json while the sandbox has a token, and removes it when it doesn't.
# On PATH through /opt/onedrop/lazy, which every process has.

token() {
    if [ -n "${GITHUB_TOKEN:-}" ]; then
        printf '%s' "$GITHUB_TOKEN"
    elif [ -r /opt/onedrop/org-secrets ]; then
        (. /opt/onedrop/org-secrets && printf '%s' "${GITHUB_TOKEN:-}")
    fi
}

case "${1:-}" in
    get)
        read -r server
        secret=$(token)

        if [ -z "$secret" ]; then
            echo 'credentials not found in native keychain'
            exit 1
        fi

        jq -n --arg server "$server" --arg secret "$secret" '{ServerURL: $server, Username: "x-access-token", Secret: $secret}'
        ;;
    list)
        if [ -n "$(token)" ]; then
            echo '{"ghcr.io": "x-access-token"}'
        else
            echo '{}'
        fi
        ;;
    store)
        cat >/dev/null
        echo 'OneDrop signs in to ghcr.io with your GitHub connection (GITHUB_TOKEN). To use another token, add it as a secret named GITHUB_TOKEN.' >&2
        exit 1
        ;;
    erase)
        cat >/dev/null
        ;;
    *)
        echo "usage: ${0##*/} get|list|store|erase" >&2
        exit 1
        ;;
esac
