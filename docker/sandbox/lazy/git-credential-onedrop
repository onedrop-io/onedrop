#!/usr/bin/env bash
# git's credential helper for the project's GitHub repository (GIT-021): git.php names it for https://github.com in
# /workspace/.git/config while the project's remote is a GitHub App repository, so `git fetch`, `git pull` and
# `git ls-remote` work there like in a clone. Each time git asks, it gets a token from the platform that can only read
# that one repository and lasts an hour; nothing is stored. It answers for no other repository or host, and refuses
# to store anything git hands it.
#
#   git-credential-onedrop get     what git runs: reads git's request on stdin, prints username and password
#   git-credential-onedrop token   prints the token (onedrop-tool hands it to gh as GH_TOKEN)
#
# On PATH through /opt/onedrop/lazy, which every process has.
set -uo pipefail

config=${ONEDROP_GIT_CREDENTIALS:-/tmp/onedrop-git-credentials}

setting() {
    sed -n "s/^$1=//p" "$config" 2>/dev/null | head -n 1
}

token() {
    local url response
    url=$(setting url)
    [ -n "$url" ] || return 1

    response=$(curl -fsS --retry 2 --max-time 30 "$url" 2>/dev/null) || {
        echo "git-credential-onedrop: OneDrop couldn't give git a token for $(setting repository). Try again in a minute." >&2
        return 1
    }

    jq -er '.password // empty' <<<"$response"
}

case "${1:-}" in
    get)
        protocol='' host='' path=''
        while IFS= read -r line && [ -n "$line" ]; do
            case "$line" in
                protocol=*) protocol=${line#protocol=} ;;
                host=*) host=${line#host=} ;;
                path=*) path=${line#path=} ;;
            esac
        done

        repository=$(setting repository)
        path=${path%/}
        path=${path%.git}

        # Only for the project's own repository on github.com: the token is never sent anywhere else.
        lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
        [ "$protocol" = https ] && [ "$(lower "$host")" = github.com ] && [ -n "$repository" ] && [ "$(lower "$path")" = "$(lower "$repository")" ] || exit 0

        secret=$(token) || exit 0
        printf 'username=x-access-token\npassword=%s\n' "$secret"
        ;;
    token)
        [ -n "$(setting repository)" ] || exit 1
        token
        ;;
    store | erase)
        cat >/dev/null
        ;;
    *)
        echo "usage: ${0##*/} get|token" >&2
        exit 1
        ;;
esac
