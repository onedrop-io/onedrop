# The organization's secrets (SECRET-003) as environment variables. Sourced before the app's start script runs
# (start.sh, hosting) and by the Shell (bashrc); the agent gets them from forwarder.mjs, as the Shell does. The platform
# writes one `NAME base64(value)` line per secret to /tmp/onedrop-org-secrets (OrganizationSecrets). Settings already in
# the environment (the platform's own) win over them. Names the project's .env sets don't: the start script often needs
# the organization's value to bootstrap (fetch secrets, pull images, download seed data); a script whose app must use
# .env's value loads .env itself before starting it.
if [ -r /tmp/onedrop-org-secrets ]; then
    while read -r __onedrop_name __onedrop_value; do
        [[ $__onedrop_name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        [ -z "${!__onedrop_name+set}" ] || continue
        export "$__onedrop_name=$(printf '%s' "$__onedrop_value" | base64 -d)"
    done </tmp/onedrop-org-secrets
    unset __onedrop_name __onedrop_value
fi
