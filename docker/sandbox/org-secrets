# The organization's secrets (SECRET-003) as environment variables. Sourced by the Shell (bashrc) and before the app
# starts (start.sh); the agent gets them from forwarder.mjs, by the same rules. The platform writes one
# `NAME base64(value)` line per secret to /tmp/onedrop-org-secrets (OrganizationSecrets). Settings already in the
# environment (the platform's own) and names the project's .env sets win over them.
if [ -r /tmp/onedrop-org-secrets ]; then
    __onedrop_project_names=$(sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=.*/\2/p' /workspace/.env 2>/dev/null)
    while read -r __onedrop_name __onedrop_value; do
        [[ $__onedrop_name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        [ -z "${!__onedrop_name+set}" ] || continue
        grep -qxF -- "$__onedrop_name" <<<"$__onedrop_project_names" && continue
        export "$__onedrop_name=$(printf '%s' "$__onedrop_value" | base64 -d)"
    done </tmp/onedrop-org-secrets
    unset __onedrop_project_names __onedrop_name __onedrop_value
fi
