#!/usr/bin/env bash
# Service CLIs (clouds, hosting, databases, infrastructure) and more coding agents that install on first use, so the
# image stays small and each one's version can change without a new image (SBX-011, SBX-012). Every command has a
# stand-in in /opt/onedrop/lazy, at the end of PATH, that runs it through here; a copy the user or the app installed
# themselves comes first on PATH.
#
#   onedrop-tool run COMMAND [ARG...]   run COMMAND, installing its tool first when this version isn't installed
#   onedrop-tool install TOOL...        install tools now (--all for every one)
#   onedrop-tool check                  install every tool and run each one's version command (CI)
#   onedrop-tool list                   each tool, its version, its commands, and whether it's installed
#   onedrop-tool commands               "TOOL COMMAND" per command, for the stand-ins' test
#
# Tools install as the sandbox user into ~/.cache/onedrop/tools/TOOL-VERSION (no root; snapshots skip caches, so
# an updated sandbox installs them again on first use). A new version replaces the old one on its next use.
set -euo pipefail

ROOT="${ONEDROP_TOOLS_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/onedrop/tools}"

