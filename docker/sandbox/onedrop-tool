# install TOOL: install the current version once (two shells running it at once wait for each other), then remove
# older versions. A half-finished install (no .installed) is started again.
install() {
    local tool=$1 v dir
    v=$(version_of "$tool")
    dir="$ROOT/$tool-$v"
    [ -e "$dir/.installed" ] && return

    mkdir -p "$ROOT"
    exec 9>"$ROOT/.$tool.lock"
    flock 9
    if [ ! -e "$dir/.installed" ]; then
        echo "Installing $tool $v (first use; it stays installed)…" >&2
        rm -rf "$dir"
        mkdir -p "$dir/bin"
        # A subshell of its own (not an `if` condition, where set -e is off), so any failed step stops the install.
        set +e
        (cd "$dir" && set -e && "install_$tool") >&2
        local status=$?
        set -e
        if [ "$status" -ne 0 ]; then
            rm -rf "$dir"
            die "couldn't install $tool $v. Check the sandbox can reach the internet, then try again."
        fi
        touch "$dir/.installed"
        find "$ROOT" -mindepth 1 -maxdepth 1 -type d -name "$tool-*" ! -name "$tool-$v" -exec rm -rf {} +
    fi
    exec 9>&-
}

run() {
    local command=${1:-} tool v
    [ -n "$command" ] || die "usage: onedrop-tool run COMMAND [ARG...]"
    tool=$(tool_for "$command") || die "$command isn't a tool onedrop-tool installs."
    shift
    install "$tool"
    v=$(version_of "$tool")
    PATH="$ROOT/$tool-$v/bin:$PATH" exec "$ROOT/$tool-$v/bin/$command" "$@"
}

# The command `check` runs to prove a tool works.
version_command() {
    case "$1" in
        doctl) echo 'doctl version' ;;
        go) echo 'go version' ;;
        helm) echo 'helm version' ;;
        k9s) echo 'k9s version --short' ;;
        kubectl) echo 'kubectl version --client' ;;
        terraform) echo 'terraform version' ;;
        tofu) echo 'tofu version' ;;
        *) echo "$(field "$(entry_of "$1")" 2 | cut -d' ' -f1) --version" ;;
    esac
}

entry_of() {
    local entry
    for entry in "${TOOLS[@]}"; do
        [ "$(field "$entry" 1)" = "$1" ] && echo "$entry" && return
    done
    return 1
}

case "${1:-}" in
    run)
        shift
        run "$@"
        ;;
    install)
        shift
        [ "${1:-}" = --all ] && set -- $(for entry in "${TOOLS[@]}"; do field "$entry" 1; done)
        [ $# -gt 0 ] || die "usage: onedrop-tool install TOOL... (or --all)"
        for tool in "$@"; do
            entry_of "$tool" >/dev/null || die "$tool isn't a tool onedrop-tool installs."
            install "$tool"
        done
        ;;
    check)
        mkdir -p "$ROOT"
        failed=0
        for entry in "${TOOLS[@]}"; do
            tool=$(field "$entry" 1)
            read -r command args <<<"$(version_command "$tool")"
            # shellcheck disable=SC2086
            if out=$("$0" run "$command" $args 2>"$ROOT/.check-errors"); then
                printf '%-12s ok  %s\n' "$tool" "$(grep -m1 . <<<"$out")"
            else
                printf '%-12s FAILED\n%s\n%s\n' "$tool" "$out" "$(cat "$ROOT/.check-errors")"
                failed=1
            fi
        done
        exit "$failed"
        ;;
    list)
        for entry in "${TOOLS[@]}"; do
            tool=$(field "$entry" 1)
            v=$(version_of "$tool")
            state='installs on first use'
            [ -e "$ROOT/$tool-$v/.installed" ] && state=installed
            printf '%-24s %-14s %-24s %s\n' "$(field "$entry" 3)" "$v" "$(field "$entry" 2)" "$state"
        done
        ;;
    commands)
        for entry in "${TOOLS[@]}"; do
            for command in $(field "$entry" 2); do echo "$(field "$entry" 1) $command"; done
        done
        ;;
    *)
        die "usage: onedrop-tool run COMMAND [ARG...] | install TOOL... | check | list | commands"
        ;;
esac
