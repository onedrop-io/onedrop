case "$(uname -m)" in
    aarch64 | arm64) arch=aarch64 goarch=arm64 node=arm64 ;;
    *) arch=x86_64 goarch=amd64 node=x64 ;;
esac

die() {
    echo "onedrop-tool: $*" >&2
    exit 1
}

# field ENTRY N: the Nth |-separated field of a TOOLS entry.
field() { cut -d'|' -f"$2" <<<"$1"; }

tool_for() {
    local entry
    for entry in "${TOOLS[@]}"; do
        if [[ " $(field "$entry" 2) " == *" $1 "* ]]; then
            field "$entry" 1
            return
        fi
    done
    return 1
}

version_of() { echo "${!1}"; }

fetch() { curl -fsSL --retry 3 --retry-connrefused "$1"; }

# untar URL [TAR-ARG...]: unpack a .tar.gz into $dir/bin.
untar() {
    local url=$1
    shift
    fetch "$url" | tar -xz -C "$dir/bin" "$@"
}

# unzip_to URL TARGET: unpack a .zip into TARGET.
unzip_to() {
    fetch "$1" >"$dir/download.zip"
    unzip -q -o "$dir/download.zip" -d "$2"
    rm "$dir/download.zip"
}

binary() { # binary URL NAME
    fetch "$1" >"$dir/bin/$2"
    chmod +x "$dir/bin/$2"
}

npm_tool() { # npm_tool PACKAGE
    npm install --prefix "$dir" --no-audit --no-fund --no-update-notifier --loglevel=error "$1@$v" >&2
    rmdir "$dir/bin"
    ln -s node_modules/.bin "$dir/bin"
}

# Each install_TOOL puts the tool's commands in $dir/bin, with the version in $v.
install_aws() {
    unzip_to "https://awscli.amazonaws.com/awscli-exe-linux-$arch-$v.zip" "$dir/src"
    "$dir/src/aws/install" --install-dir "$dir/aws-cli" --bin-dir "$dir/bin" >/dev/null
    rm -rf "$dir/src"
}
install_az() {
    # uv's own Python, inside the tool's folder (not ~/.local, which snapshots keep).
    export UV_PYTHON_INSTALL_DIR="$dir/python"
    uv venv --quiet --python 3.12 "$dir/venv"
    uv pip install --quiet --python "$dir/venv/bin/python" "azure-cli==$v"
    ln -s ../venv/bin/az "$dir/bin/az"
}
install_bun() {
    local name=bun-linux-${arch/x86_64/x64}
    unzip_to "https://github.com/oven-sh/bun/releases/download/bun-v$v/$name.zip" "$dir"
    mv "$dir/$name/bun" "$dir/bin/bun" && rmdir "$dir/$name"
    ln -s bun "$dir/bin/bunx"
}
install_cloud() {
    composer require --working-dir "$dir" --no-interaction --quiet "laravel/cloud-cli:$v"
    ln -s ../vendor/bin/cloud "$dir/bin/cloud"
}
